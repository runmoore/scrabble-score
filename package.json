{
  "name": "scrabble-score-e630",
  "private": true,
  "description": "",
  "license": "",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env NODE_ENV=development binode --require ./mocks/index.cjs -- @react-router/dev:react-router dev",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma migrate dev && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "start:mocks": "binode --require ./mocks/index.cjs -- @react-router/serve:react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 \"cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env PORT=8811 start-server-and-test start:mocks http://localhost:8811 \"cypress run\"",
    "typecheck": "react-router typegen && tsc -b && tsc -b cypress",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run"
  },
  "prettier": {},
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@react-router/node": "7.18.6",
    "@react-router/serve": "7.18.6",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "isbot": "^5.1.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.6",
    "recharts": "^3.10.1",
    "tiny-invariant": "^1.2.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^8.2.0",
    "@react-router/dev": "7.18.6",
    "@testing-library/cypress": "^10.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.4",
    "binode": "^1.0.5",
    "c8": "^7.11.0",
    "cross-env": "^7.0.3",
    "cypress": "^13.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "msw": "^2.2.13",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.12",
    "prettier": "2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.0",
    "prisma": "^5.20.0",
    "start-server-and-test": "^1.14.0",
    "tailwindcss": "^3.0.23",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "cypress": true,
    "fsevents": true,
    "msw": true,
    "prisma": true
  }
}
